# This is Git's per-user configuration file.
[user]
	name = Eliseo Martelli
	email = me@eliseomartelli.it
	signingkey = 2665A87FC27800848A748772F9BC10131561ED55
[commit]
	gpgsign = true
[gpg]
	program = gpg
[init]
	defaultBranch = main
[alias]
	adog = log --all --decorate --oneline --graph
	dog = log --decorate --oneline --graph
	pushall = !git remote | xargs -L1 git push --all
	st = status -s
	rib = "!f() { \
		base=$(git merge-base HEAD $1); \
		git rebase --interactive $base; \
	}; f $1"
	changes = diff --name-status
	incoming = !git fetch && git log ..@{u} --oneline
	outgoing = log @{u}.. --oneline
	wp = !sh \"$HOME/.config/git/wp.sh\"
[push]
	followTags = true
	autoSetupRemote = true
[merge]
	tool = nvimdiff
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[color]
	ui = always
# Machine-specific overrides (work identity, etc.). Untracked; must stay last.
[include]
	path = config.local
